# Variáveis do /opt/sgi-nv/.env na sgi-nv. Cada release aponta para ele (releases/<versão>/.env ->
# /opt/sgi-nv/.env). Nunca versionar o .env (Spec §5).
#
# Na AWS, o .env é gerado a partir do SSM (decisão 0.2.4): os endereços vêm do Terraform, e o
# DB_PASSWORD e qualquer valor que substitua um padrão vêm de /sgi/<workspace>/sgi-nv/env/<VARIÁVEL>.
# Este modelo serve para conferência e para subir o compose fora da AWS.

# --- Rede ---
# IP privado da sgi-nv (terraform output sgi_nv); a 8080 e a 8025 são publicadas só nele.
SGINV_IP_PRIVADO=10.0.2.10

# --- Banco de dados (PostgreSQL na db) ---
# IP privado da db (terraform output db). O sginv só tem DML no schema public (T-020).
DB_HOST=10.0.3.10
DB_PORT=5432
DB_NAME=sgi
DB_USERNAME=sginv
DB_PASSWORD=

# --- Memória ---
FRONTEND_XMX=2g
JOBS_XMX=1g

# --- E-mail (fase 1: tudo para o MailHog, nada sai) ---
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SSL=false
MAIL_STARTTLS=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=suporte_sgi@copony.com.br
MAIL_DEBUG=false
# Obrigatório. O padrão do email.properties é um endereço real; aqui, um que só o MailHog recebe.
MAIL_REDIRECT_TO=fase1@mailhog.local
