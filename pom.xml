		<build>
			<plugins>
				<plugin>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.1.0</version>
					<executions>
						<execution>
							<id>copy-resource-one</id>
							<phase>package</phase>
							<goals>
								<goal>copy-resources</goal>
							</goals>
							<configuration>
								<skip>${module.deploy.skip}</skip>
								<outputDirectory>${project-rootdir}/build/target</outputDirectory>
								<resources>
									<resource>
										<directory>${project.build.directory}</directory>
										<includes>
											<include>*.war</include>
											<include>*.jar</include>
										</includes>
										<excludes>
											<exclude>*.jar.original</exclude>
										</excludes>
									</resource>
								</resources>
							</configuration>
							</execution>
					</executions>
				</plugin>
			</plugins>
		</build>
