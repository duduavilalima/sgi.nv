<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>br.com.fasolti.sgi</groupId>
	<artifactId>testes</artifactId>
	<version>5.13.6</version>

	<name>SGI :: Nova Versão :: Test module</name>
	<packaging>jar</packaging>

	<description>Projeto de teste do SGI (Nova Arquitetura)</description>

	<organization>
		<name>Fasolti</name>
		<url>http://www.fasolti.com.br/</url>
	</organization>
	<issueManagement>
		<system>Jira</system>
		<url>https://jira.fasolti.com.br</url>
	</issueManagement>
	<scm>
		<url>http://svn.dev.copony.com.br/projects/aa/sgi/</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<selenium-java-version>2.53.0</selenium-java-version>
		<junit-version>4.11</junit-version>
		<testcase.groups></testcase.groups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>${selenium-java-version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit-version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>default</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<testcase.groups>br.com.fasolti.teste.util.IntegrationTests
				</testcase.groups>
			</properties>
		</profile>
		<profile>
			<id>integrationTests</id>
			<properties>
				<testcase.groups>br.com.fasolti.teste.util.IntegrationTests
				</testcase.groups>
			</properties>
		</profile>
		<profile>
			<id>faturamento</id>
			<properties>
				<testcase.groups>br.com.fasolti.teste.suite</testcase.groups>
			</properties>
		</profile>
	</profiles>

	<!-- FIXME
	<reporting>
		<plugins>
		  <plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-report-plugin</artifactId>
			<version>2.19.1</version>
			<configuration>
				<groups>${testcase.groups}</groups>
			</configuration>
		  </plugin>
		</plugins>
	</reporting>
	-->

</project>
