<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		  xmlns="http://dozer.sourceforge.net"
		  xsi:schemaLocation="http://dozer.sourceforge.net http://dozer.sourceforge.net/schema/beanmapping.xsd">

	<mapping>
		<class-a>
			br.com.araujoabreu.sgi.service.nota.transfer.NotaTributoAliquotaTO
		</class-a>
		<class-b>
			br.com.araujoabreu.sgi.controleFiscal.domain.NotaTributoAliquota
		</class-b>

		<field-exclude>
			<a>nota</a>
			<b>nota</b>
		</field-exclude>

		<field-exclude>
			<a>aliquota</a>
			<b>aliquota</b>
		</field-exclude>

		<field>
			<a>nota.codigo</a>
			<b>nota.codigo</b>
		</field>

		<field>
			<a>aliquota.codigo</a>
			<b>aliquota.codigo</b>
		</field>
	</mapping>

</mappings>
