<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>br.com.fasolti.sgi</groupId>
		<artifactId>servers</artifactId>
		<version>5.13.6</version>
	</parent>

	<artifactId>rest</artifactId>
	<packaging>war</packaging>

	<name>SGI :: Nova Versão :: REST Server</name>

	<properties>
	    <project-rootdir>${project.basedir}/../..</project-rootdir>
		<!-- Contexto da aplicação -->
		<server.context>/sgi</server.context>
		<application.context>/rest</application.context>
	</properties>

	<dependencies>
		<!-- Spring -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-cas</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- FASOLTI -->
		<dependency>
			<groupId>br.com.fasolti.commons</groupId>
			<artifactId>commons-rest</artifactId>
		</dependency>
		<dependency>
			<groupId>br.com.fasolti.sgi</groupId>
			<artifactId>services.client</artifactId>
		</dependency>
		<dependency>
			<groupId>br.com.fasolti.sgi</groupId>
			<artifactId>services</artifactId>
		</dependency>
		<!-- JSON -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}</outputDirectory>
							<resources>
								<resource>
									<directory>../src/main/resources</directory>
									<filtering>true</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
