	<!--				<value-->
	<!--					type="com.fasterxml.jackson.databind.DeserializationFeature">FAIL_ON_UNKNOWN_PROPERTIES</value>-->
	<!--				<value>false</value>-->
	<!--			</list>-->
	<!--		</property>-->
	<!--	</bean>-->

	<!-- Formatação de data padrão ISO no Jackson -->
	<bean id="jacksonObjectMapper" class="br.com.araujoabreu.sgi.util.CustomObjectMapper" primary="true"/>

	<!-- Dozer mappings -->
	<bean class="org.dozer.spring.DozerBeanMapperFactoryBean">
		<property name="mappingFiles" value="classpath*:/**/*-map.xml"/>
	</bean>
</beans>
